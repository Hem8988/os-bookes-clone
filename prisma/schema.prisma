// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Unit {
  id                String  @id
  code              String
  name              String
  symbol            String
  isDecimalAllowed  Boolean @default(false)
}

model Category {
  id                String  @id
  name              String
  hsnDefault        String?
  itemCount         Int     @default(0)
  active            Boolean @default(true)
  purchaseDiscount  Float?
  saleDiscount      Float?
  image             String?
}

model Brand {
  id            String @id
  name          String
  manufacturer  String
}

model Tax {
  id    String @id
  name  String
  rate  Float
  cgst  Float
  sgst  Float
  igst  Float
}

model Bank {
  id              String  @id
  accountName     String
  bankName        String
  accountNumber   String
  ifscCode        String
  branch          String
  openingBalance  Float   @default(0)
  currentBalance  Float   @default(0)
  upiId           String?
  qrCodeUrl       String?
  address         String?
  bookType        String?
}

model BookType {
  id    String @id @default(cuid())
  name  String @unique
}

model Employee {
  id                        String  @id
  name                      String
  role                      String
  phone                     String
  email                     String
  salary                    Float   @default(0)
  commissionPercent         Float   @default(0)
  active                    Boolean @default(true)
  city                      String?
  joiningDate               String?
  designation               String?
  salaryType                String?
  paidHoliday               Int?
  specialCommission         Float?
  totalSaleCommission       Float?
  commissionOnManufacturing Boolean?
}

model Expense {
  id             String  @id
  categoryName   String
  hsnSac         String?
  gstRate        Float   @default(0)
  monthlyBudget  Float   @default(0)
  ytdSpent       Float   @default(0)
  active         Boolean @default(true)
  expenseHead    String
  expenseType    String
}

model Income {
  id          String @id
  sourceName  String
  hsnSac      String?
  gstRate     Float  @default(0)
  ytdEarned   Float  @default(0)
}

model PaymentModeMaster {
  id                    String  @id
  modeName              String
  linkedAccount         String
  transactionFeePercent Float   @default(0)
  active                Boolean @default(true)
}

model Bom {
  id                String  @id
  finishedGoodId    String
  finishedGoodName  String
  bomCode           String
  laborCost         Float   @default(0)
  totalCost         Float   @default(0)
  active            Boolean @default(true)
  components        Json
}

model Company {
  id            String  @id
  companyName   String
  tradeName     String
  gstin         String
  pan           String
  phone         String
  email         String
  address       String
  city          String
  state         String
  stateCode     String
  pincode       String
  isMainBranch  Boolean @default(false)
}

model Account {
  id              String  @id
  accountName     String
  group           String
  openingBalance  Float   @default(0)
  currentBalance  Float   @default(0)
  gstin           String?
  phone           String?
  city            String?
  state           String?
  address         String?
}

model Product {
  id                        String   @id
  name                      String
  category                  String
  brand                     String?
  sku                       String
  barcode                   String?
  hsnCode                   String
  unit                      String
  purchasePrice             Float    @default(0)
  salePrice                 Float    @default(0)
  mrp                       Float?
  taxRate                   Float    @default(0)
  stock                     Float    @default(0)
  minStockAlert             Float    @default(0)
  maxStockLimit             Float?
  rackLocation              String?
  batchNumber               String?
  expiryDate                String?
  groupCode                 String?
  active                    Boolean  @default(true)
  gstApplicable             Boolean?
  autoQty                   Float?
  productType               String?  // 'LPG_COMMERCIAL' | 'LPG_INDUSTRIAL' | 'MEDICAL_OXYGEN' | 'NITROGEN' | 'ARGON'
  gasType                   String?  @default("LPG")
  weightVolume              Float?   @default(0)
  emptyDepositValue         Float    @default(0)
  isMoreInfo                Boolean?
  isRawMaterial             Boolean?
  isSubItem                 Boolean?
  image                     String?
  size                      String?
  colour                    String?
  expiryMonth               Int?
  productHindiName          String?
  description               String?
  termsAndCondition         String?
  productTags               String[]
  parentProductId           String?
  parentProductName         String?
  subItemConversionQty      Float?
  rawMaterialComponents     ProductRawMaterialComponent[]
}

model ProductRawMaterialComponent {
  id              String  @id @default(cuid())
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId       String
  componentProductId    String
  componentProductName  String
  productCode     String?
  quantity        Float
  unit            String
  unitCost        Float
  mrp             Float?
  salePrice       Float?
  wholesalePrice  Float?
  image           String?
  customValues    Json?
}

model Customer {
  id              String   @id
  tenantId        String   @default("tenant_default")
  name            String
  tradeName       String?
  contactPerson   String?
  phone           String
  email           String
  gstin           String?
  address         String
  city            String
  state           String
  stateCode       String?
  balance         Float    @default(0)
  creditLimit     Float    @default(0)
  creditDays      Int?
  type            String
  accountGroup    String
  active          Boolean? @default(true)
  status          String   @default("ACTIVE") // 'ACTIVE' | 'INACTIVE' | 'BLOCKED'
  internalNotes   String?
  dueDays         Int?
  tags            String[]
  isMoreInfo      Boolean?
  isWholeParty    Boolean?
  isSezParty      Boolean?
  isFocParty      Boolean?
  isShowPartyRate Boolean?
  pincode         String?
  gstApplicable   String?
  partyType       String?
  otherMobile     String?
  interestRate    Float?
  loyaltyPoints   Float?
  joiningDate     String?
  rateMode        String?
  whatsappNumber  String?
  area            String?
  route           String?
  defaultDeliveryBoyId String?
  defaultProductIds String[]
  openingEmptyCylinderQty Float? @default(0)
  partyRates      PartyRate[]
  followUps       FollowUp[]
  cylinderInventories CustomerCylinderInventory[]
  vouchers        CylinderVoucher[]
  deliveryAddresses CustomerAddress[]
}

model CustomerAddress {
  id          String   @id @default(cuid())
  tenantId    String   @default("tenant_default")
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label       String   // e.g. 'Godown 1', 'Main Factory'
  address     String
  city        String?
  state       String?
  pincode     String?
  area        String?
  route       String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Area {
  id          String   @id @default(cuid())
  tenantId    String   @default("tenant_default")
  code        String   @unique
  name        String
  routeId     String?
  route       Route?   @relation(fields: [routeId], references: [id])
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Route {
  id                    String   @id @default(cuid())
  tenantId              String   @default("tenant_default")
  code                  String   @unique
  name                  String
  defaultDeliveryBoyId  String?
  areas                 Area[]
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
}

model User {
  id            String    @id @default(cuid())
  tenantId      String    @default("tenant_default")
  name          String
  email         String    @unique
  mobile        String?
  password      String
  role          String    // 'ADMIN' | 'ACCOUNTANT' | 'DELIVERY_BOY' | 'CUSTOMER'
  status        String    @default("ACTIVE") // 'ACTIVE' | 'INACTIVE'
  customerId    String?
  deliveryBoyId String?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model UserRole {
  id          String   @id @default(cuid())
  tenantId    String   @default("tenant_default")
  email       String   @unique
  name        String
  role        String   // 'SUPER_ADMIN' | 'MANAGER' | 'ACCOUNTANT' | 'DELIVERY_BOY'
  permissions String[]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model PartyRate {
  id          String   @id @default(cuid())
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId  String
  productId   String
  productName String
  price       Float
}

model FollowUp {
  id            String   @id
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId    String
  type          String
  note          String
  followUpDate  String
  createdAt     String
}

model Invoice {
  id              String        @id
  tenantId        String        @default("tenant_default")
  invoiceNumber   String
  date            String
  dueDate         String
  customerId      String
  customerName    String
  customerGstin   String?
  customerPhone   String
  salesmanId      String?
  salesmanName    String?
  subTotal        Float         @default(0)
  totalDiscount   Float         @default(0)
  totalCgst       Float         @default(0)
  totalSgst       Float         @default(0)
  totalIgst       Float         @default(0)
  roundOff        Float         @default(0)
  grandTotal      Float         @default(0)
  paymentMode     String
  bankAccountId   String?
  status          String
  isIgst          Boolean       @default(false)
  notes           String?
  items           InvoiceItem[]
}

model InvoiceItem {
  id              String  @id @default(cuid())
  invoice         Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId       String
  productId       String
  productName     String
  hsnCode         String
  quantity        Float
  unit            String
  unitPrice       Float
  mrp             Float?
  discountPercent Float   @default(0)
  taxRate         Float   @default(0)
  taxableAmount   Float   @default(0)
  cgstAmount      Float   @default(0)
  sgstAmount      Float   @default(0)
  igstAmount      Float   @default(0)
  totalAmount     Float   @default(0)
}

model PurchaseOrder {
  id            String @id
  poNumber      String
  vendorName    String
  vendorGstin   String?
  date          String
  expectedDate  String
  itemsCount    Int    @default(0)
  totalAmount   Float  @default(0)
  status        String
}

model PurchaseInvoice {
  id                    String @id
  purchaseNumber        String
  vendorInvoiceNumber   String
  vendorName            String
  vendorGstin           String
  date                  String
  subTotal              Float  @default(0)
  itcEligibleAmount     Float  @default(0)
  grandTotal            Float  @default(0)
  status                String
}

model ReturnDocument {
  id                String @id
  docNumber         String
  originalInvNumber String
  partyName         String
  date              String
  returnReason      String
  amount            Float  @default(0)
  status            String
  kind              String // 'Purchase' | 'Sales'
}

model SaleOrder {
  id            String @id
  soNumber      String
  customerName  String
  date          String
  validUntil    String
  totalAmount   Float  @default(0)
  status        String
}

model DeliveryChallan {
  id              String @id
  challanNumber   String
  customerName    String
  vehicleNumber   String
  dispatchDate    String
  itemsCount      Int    @default(0)
  totalQty        Float  @default(0)
  status          String
}

model Quotation {
  id            String @id
  quoteNumber   String
  customerName  String
  customerPhone String
  date          String
  validDays     Int    @default(0)
  grandTotal    Float  @default(0)
  status        String
}

model StockAdjustment {
  id              String @id
  adjustCode      String
  date            String
  productName     String
  adjustmentType  String
  qty             Float  @default(0)
  reason          String
  approvedBy      String
}

model BranchStockTransfer {
  id              String @id
  transferNumber  String
  type            String
  fromBranch      String
  toBranch        String
  date            String
  itemsCount      Int    @default(0)
  totalQty        Float  @default(0)
  status          String
}

model LedgerEntry {
  id              String @id @default(cuid())
  tenantId        String @default("tenant_default")
  ledgerType      String // 'customer' | 'company' | 'bank' | 'employee' | 'expenses' | 'incomes' | 'payment'
  date            String
  voucherNumber   String
  accountName     String
  particulars     String
  debit           Float  @default(0)
  credit          Float  @default(0)
  balance         Float  @default(0)
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String   @default("tenant_default")
  timestamp   DateTime @default(now())
  actorEmail  String
  action      String
  details     String
  ipAddress   String?  @default("127.0.0.1")
  deviceInfo  String?  @default("Web Dashboard")
  oldValue    String?
  newValue    String?
  reference   String?
  reason      String?
}

model DeliveryBoyDevice {
  id               String   @id @default(cuid())
  tenantId         String   @default("tenant_default")
  deliveryBoyId    String   @unique
  deliveryBoyName  String
  deviceId         String   @unique
  deviceModel      String
  isVerified       Boolean  @default(true)
  registeredAt     DateTime @default(now())
  lastActiveAt     DateTime @updatedAt
}

model Attendance {
  id              String @id
  employeeId      String
  employeeName    String
  date            String
  checkIn         String
  checkOut        String
  status          String
  overtimeHours   Float  @default(0)
}

model CustomerCylinderInventory {
  id                   String   @id @default(cuid())
  tenantId             String   @default("tenant_default")
  customer             Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId           String
  productId            String
  productName          String
  openingQty           Float    @default(0)
  deliveredQtyTotal    Float    @default(0)
  emptyReceivedTotal   Float    @default(0)
  adjustmentQty        Float    @default(0)
  currentEmptyBalance  Float    @default(0)
  currentFullBalance   Float    @default(0)
  defectiveQty         Float    @default(0)
  inTransitRefillQty   Float    @default(0)
  updatedAt            DateTime @updatedAt
}

model InventoryTransaction {
  id               String   @id @default(cuid())
  tenantId         String   @default("tenant_default")
  referenceNumber  String
  transactionType  String   // 'PURCHASE_RECEIPT' | 'WAREHOUSE_TO_DRIVER' | 'DRIVER_TO_CUSTOMER' | 'CUSTOMER_EMPTY_RETURN' | 'DRIVER_TO_DRIVER' | 'DRIVER_TO_WAREHOUSE' | 'DEFECTIVE_RETURN' | 'MANUAL_ADJUSTMENT'
  sourceType       String   // 'WAREHOUSE' | 'DELIVERY_BOY' | 'CUSTOMER' | 'PLANT'
  sourceId         String?
  targetType       String   // 'WAREHOUSE' | 'DELIVERY_BOY' | 'CUSTOMER' | 'PLANT'
  targetId         String?
  productId        String
  productName      String
  fullQty          Float    @default(0)
  emptyQty         Float    @default(0)
  adjustmentQty    Float    @default(0)
  performedBy      String
  reason           String?
  createdAt        DateTime @default(now())
}

model StockTransfer {
  id               String              @id @default(cuid())
  tenantId         String              @default("tenant_default")
  transferNumber   String              @unique
  transferType     String              // 'WAREHOUSE_TO_DRIVER' | 'DRIVER_TO_DRIVER' | 'DRIVER_TO_WAREHOUSE'
  fromLocationType String              // 'WAREHOUSE' | 'DELIVERY_BOY'
  fromLocationId   String
  toLocationType   String              // 'WAREHOUSE' | 'DELIVERY_BOY'
  toLocationId     String
  status           String              @default("PENDING_APPROVAL") // 'PENDING_APPROVAL' | 'APPROVED' | 'REJECTED'
  approvedBy       String?
  approvedAt       DateTime?
  notes            String?
  items            StockTransferItem[]
  createdAt        DateTime            @default(now())
}

model StockTransferItem {
  id              String        @id @default(cuid())
  transfer        StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  transferId      String
  productId       String
  productName     String
  fullQty         Float         @default(0)
  emptyQty        Float         @default(0)
}

model CylinderOrder {
  id                    String              @id @default(cuid())
  tenantId              String              @default("tenant_default")
  orderNumber           String              @unique
  customerId            String
  customerName          String
  customerPhone         String
  whatsappNumber        String?
  source                String              @default("MANUAL") // 'WHATSAPP' | 'MANUAL' | 'ADMIN'
  status                String              @default("PENDING_APPROVAL") // 'WHATSAPP_RECEIVED' | 'PENDING_APPROVAL' | 'APPROVED' | 'ASSIGNED' | 'OUT_FOR_DELIVERY' | 'DELIVERED' | 'PENDING_VERIFICATION' | 'COMPLETED' | 'REJECTED'
  requestedDeliveryDate String
  deliveryAddress       String?
  area                  String?
  route                 String?
  assignedDeliveryBoyId String?
  assignedDeliveryBoyName String?
  approvedBy            String?
  approvedAt            String?
  rejectionReason       String?
  isCreditOverLimit     Boolean             @default(false)
  items                 CylinderOrderItem[]
  deliveries            CylinderDelivery[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

model CylinderOrderItem {
  id              String        @id @default(cuid())
  order           CylinderOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId         String
  productId       String
  productName     String
  orderedQty      Float
  unitPrice       Float         @default(0)
  totalAmount     Float         @default(0)
}

model CylinderDelivery {
  id                    String                 @id @default(cuid())
  tenantId              String                 @default("tenant_default")
  deliveryNumber        String                 @unique
  orderId               String
  order                 CylinderOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId            String
  customerName          String
  deliveryBoyId         String
  deliveryBoyName       String
  deliveryDate          String
  deliveredQtyTotal     Float                  @default(0)
  emptyReceivedTotal    Float                  @default(0)
  hasVariance           Boolean                @default(false)
  varianceNotes         String?
  paymentMode           String                 @default("COD") // 'CASH' | 'ONLINE' | 'CHEQUE' | 'CREDIT'
  paymentAmount         Float                  @default(0)
  transactionId         String?
  chequeNumber          String?
  chequeBank            String?
  chequeDate            String?
  chequePhotoUrl        String?
  paymentProofPhotoUrl  String?
  deliveryProofPhotoUrl String?
  remarks               String?
  status                String                 @default("PENDING_VERIFICATION") // 'PENDING_VERIFICATION' | 'VERIFIED' | 'REJECTED'
  verifiedBy            String?
  verifiedAt            String?
  verificationNotes     String?
  items                 CylinderDeliveryItem[]
  createdAt             DateTime               @default(now())
}

model DeliveryBoyDayLog {
  id                    String    @id @default(cuid())
  tenantId              String    @default("tenant_default")
  deliveryBoyId         String
  deliveryBoyName       String
  date                  String
  dayStatus             String    @default("DAY_STARTED") // 'DAY_STARTED' | 'DAY_CLOSED'
  openingFullCylinders  Float     @default(0)
  openingEmptyCylinders Float     @default(0)
  openingCash           Float     @default(0)
  closingFullCylinders  Float?
  closingEmptyCylinders Float?
  closingCash           Float?
  totalCashCollected    Float     @default(0)
  totalOnlineCollected  Float     @default(0)
  totalCreditDelivered  Float     @default(0)
  totalCashSubmitted    Float     @default(0)
  startedAt             DateTime  @default(now())
  closedAt              DateTime?
}

model DayLock {
  id               String    @id @default(cuid())
  tenantId         String    @default("tenant_default")
  date             String    @unique
  isLocked         Boolean   @default(true)
  lockedBy         String
  lockedAt         DateTime  @default(now())
  reopenedBy       String?
  reopenedAt       DateTime?
  reopenReason     String?
  expectedCash     Float     @default(0)
  actualCash       Float     @default(0)
  cashDifference   Float     @default(0)
  expectedStock    Float     @default(0)
  actualStock      Float     @default(0)
  stockDifference  Float     @default(0)
}

model CylinderDeliveryItem {
  id                   String           @id @default(cuid())
  delivery             CylinderDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  deliveryId           String
  productId            String
  productName          String
  deliveredQty         Float
  emptyReceivedQty     Float            @default(0)
  unitPrice            Float            @default(0)
  totalAmount          Float            @default(0)
}

model ApprovalQueueItem {
  id            String   @id @default(cuid())
  tenantId      String   @default("tenant_default")
  requestType   String   // 'ORDER_APPROVAL' | 'DELIVERY_VERIFICATION' | 'CASH_SUBMISSION' | 'STOCK_TRANSFER' | 'CREDIT_OVERRIDE'
  referenceId   String
  requestedBy   String
  status        String   @default("PENDING") // 'PENDING' | 'APPROVED' | 'REJECTED'
  assignedTo    String?  // 'MANAGER' | 'ACCOUNTANT' | 'ADMIN'
  payload       Json?
  notes         String?
  actionBy      String?
  actionAt      DateTime?
  createdAt     DateTime @default(now())
}

model DeliveryBoyWallet {
  id                    String   @id @default(cuid())
  deliveryBoyId         String   @unique
  deliveryBoyName       String
  openingCash           Float    @default(0)
  collectedCashTotal    Float    @default(0)
  submittedCashTotal    Float    @default(0)
  currentCashBalance    Float    @default(0)
  openingCylinderStock  Json?
  currentCylinderStock  Json?
  lastClosedAt          String?
  updatedAt             DateTime @updatedAt
}

model CashSubmission {
  id                String   @id @default(cuid())
  submissionNumber  String   @unique
  deliveryBoyId     String
  deliveryBoyName   String
  amount            Float
  proofPhotoUrl     String?
  status            String   @default("PENDING") // 'PENDING' | 'APPROVED' | 'REJECTED'
  verifiedBy        String?
  verifiedAt        String?
  notes             String?
  createdAt         DateTime @default(now())
}

model WhatsAppSession {
  id             String   @id @default(cuid())
  phone          String   @unique
  customerId     String?
  step           String   @default("IDLE") // 'IDLE' | 'MENU' | 'SELECT_PRODUCT' | 'ENTER_QTY' | 'SELECT_DATE' | 'CONFIRM'
  failedAttempts Int      @default(0)
  draftOrder     Json?
  lastMessageAt  DateTime @updatedAt
}

model CylinderVoucher {
  id            String   @id @default(cuid())
  tenantId      String   @default("tenant_default")
  voucherNumber String   @unique
  voucherType   String   // 'SV' (Subscription Voucher) | 'TV' (Transfer Voucher)
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  cylinderQty   Int      @default(1)
  regulatorQty  Int      @default(1)
  depositAmount Float    @default(0)
  issueDate     String
  status        String   @default("ACTIVE") // 'ACTIVE' | 'CANCELLED' | 'TRANSFERRED'
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

