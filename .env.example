# ── Required ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/deskshark?schema=public"
# At least 32 random characters; signs the login session cookie.
SESSION_SECRET="change-me-to-a-long-random-string-of-32+-chars"
# Public URL of the app (used for WebAuthn biometric login and invoice links).
APP_URL="http://localhost:3000"
APP_TIMEZONE="Asia/Kolkata"
DEFAULT_TENANT_ID="default"

# ── WhatsApp Business Cloud API (SRS §13) ──────────────────────────────────
# Without these, messages are logged as SIMULATED in WhatsApp → Message log.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# App secret — verifies the X-Hub-Signature-256 header on the webhook.
WHATSAPP_APP_SECRET=""
# Any string; also entered in the Meta webhook configuration.
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_API_VERSION="v21.0"

# ── Email (invoices / statements) ──────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="DeskShark <billing@example.com>"

# ── SMS fallback for OTP / payment alerts (JSON POST {to, message, sender}) ─
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER_ID=""

# ── Web push (generate with: npx web-push generate-vapid-keys) ─────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# ── File storage for proof photos ──────────────────────────────────────────
# "local" (default, saved under ./storage/uploads) or "s3".
STORAGE_DRIVER="local"
STORAGE_DIR=""
S3_BUCKET=""
S3_REGION="ap-south-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── Jobs & integrations ────────────────────────────────────────────────────
# Bearer token for POST /api/cron/outstanding-reminders (call once a day).
CRON_SECRET=""
# HMAC secret for the online-payment gateway webhook (/api/payments/callback).
PAYMENT_WEBHOOK_SECRET=""

# ── Database backups (npm run db:backup, schedule daily) ─────────────────
BACKUP_DIR=""
# Off-server copy (uses the S3_* credentials above)
BACKUP_S3_BUCKET=""

# ── Android delivery app (Trusted Web Activity, see android/README.md) ───
ANDROID_TWA_PACKAGE=""
ANDROID_TWA_SHA256=""

# ── Seed (optional; random passwords are generated and printed if empty) ───
SEED_COMPANY_NAME=""
SEED_ADMIN_PASSWORD=""
SEED_MANAGER_PASSWORD=""
SEED_ACCOUNTANT_PASSWORD=""
SEED_DRIVER_PASSWORD=""
SEED_CUSTOMER_PASSWORD=""
